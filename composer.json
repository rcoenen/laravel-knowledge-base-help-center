{
    "name": "rcoenen/laravel-knowledge-base-help-center",
    "description": "A ready-made, restylable public help center for jeffersongoncalves/laravel-knowledge-base: multi-language, search, FAQ and topic pages, no JavaScript build.",
    "keywords": [
        "laravel",
        "knowledge-base",
        "help-center",
        "faq",
        "multilingual"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "jeffersongoncalves/laravel-knowledge-base": "^1.1",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Rcoenen\\KnowledgeBaseHelpCenter\\": "src/",
            "Rcoenen\\KnowledgeBaseHelpCenter\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rcoenen\\KnowledgeBaseHelpCenter\\HelpCenterServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Rcoenen\\KnowledgeBaseHelpCenter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
